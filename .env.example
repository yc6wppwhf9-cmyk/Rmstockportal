# Supabase — item catalogue (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server only

# Cloudinary — photo hosting (Dashboard → Product Environment Credentials)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key                   # server only
CLOUDINARY_API_SECRET=your-api-secret             # server only

# Optional — passcode to protect the /manage (add & import) screen.
# Leave unset to keep it open (internal-only deployments).
MANAGE_PASSCODE=choose-a-passcode
